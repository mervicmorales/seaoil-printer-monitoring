# Copy these names into Coolify's Compose environment settings.
# Generate unique random values for every CHANGE_ME entry.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
AUTH_SECRET=CHANGE_ME_LONG_RANDOM_AUTH_SECRET
MFA_ENCRYPTION_KEY=CHANGE_ME_DIFFERENT_LONG_RANDOM_MFA_KEY
SETTINGS_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_ENCRYPTION_KEY
AGENT_STATUS_CRON_SECRET=CHANGE_ME_LONG_RANDOM_CRON_SECRET
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_SUPER_ADMIN_PASSWORD
SEED_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_ADMIN_PASSWORD
SEED_SUPPORT_PASSWORD=CHANGE_ME_UNIQUE_SUPPORT_PASSWORD
PRINTDASH_ADMIN_PASSWORD=CHANGE_ME_UNIQUE_AGENT_ADMIN_PASSWORD
PRINTDASH_USER_PASSWORD=CHANGE_ME_UNIQUE_AGENT_USER_PASSWORD

# Public URL used in links sent by production email.
APP_BASE_URL=http://seaprint.seaoil.com.ph:3000
DASHBOARD_PORT=3000
PRINTDASH_PORT=3003
MONITORING_STALE_SECONDS=180

# Configure these after the dashboard database has been initialized.
SEAOIL_AGENT_TOKEN=
SEAOIL_AGENT_KEY=head-office-agent
SEAOIL_AGENT_NAME=Head Office Agent
SEAOIL_AGENT_LOCATION=Head Office
SEAOIL_SNMP_COMMUNITY=public
POLL_INTERVAL_SECONDS=60
SEAOIL_CONFIG_REFRESH_SECONDS=60

# Optional SMTP fallback. These may remain empty and be configured in the UI.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply.printerservices@seaoil.com.ph
SMTP_FROM_NAME=SEA Print
ALERT_EMAIL_TO=
