# SMTP email delivery. Mailpit uses no authentication by default.
# Required for signed sessions. Generate a unique random value of at least 32 characters.
AUTH_SECRET=
# Required for encrypting authenticator secrets. Use a different random value.
MFA_ENCRYPTION_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply.printerservices@seaoil.com.ph
SMTP_FROM_NAME=SEA Print
ALERT_EMAIL_TO=

# Recommended monitoring-agent release shown in Agent Management.
LATEST_AGENT_VERSION=4.0.0

# Agent heartbeat age before the dashboard treats it as offline.
MONITORING_STALE_SECONDS=180

# Nightly monitoring retention (defaults run at 02:30 Asia/Manila).
MONITORING_RETENTION_ENABLED=true
MONITORING_RAW_RETENTION_DAYS=30
MONITORING_SUMMARY_RETENTION_DAYS=730
RESOLVED_ALERT_RETENTION_DAYS=365
RETENTION_DELETE_BATCH_SIZE=10000
MONITORING_RETENTION_HOUR=2
MONITORING_RETENTION_MINUTE=30
MONITORING_RETENTION_TIMEZONE=Asia/Manila

# Maximum PostgreSQL connections per dashboard process (1-20; default 10).
DB_POOL_MAX=10

# Optional build-time CDN origin for Next.js /_next/static assets only.
# Leave empty until a CDN is configured to serve the matching build files.
NEXT_ASSET_PREFIX=

# Required by scripts/seed.mjs. Set this secret locally; never commit its value.
SEED_SUPER_ADMIN_PASSWORD=
