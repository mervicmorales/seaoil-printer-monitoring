# SMTP email delivery. Mailpit uses no authentication by default.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=printer@seaoil.com.ph
SMTP_FROM_NAME=SEAOIL Printer
ALERT_EMAIL_TO=

# Recommended monitoring-agent release shown in Agent Management.
LATEST_AGENT_VERSION=4.0.0

# Agent heartbeat age before the dashboard treats it as offline.
MONITORING_STALE_SECONDS=180

# Required by scripts/seed.mjs. Set this secret locally; never commit its value.
SEED_SUPER_ADMIN_PASSWORD=
