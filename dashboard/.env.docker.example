POSTGRES_DB=app_db
POSTGRES_USER=seaoil_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://seaoil_app:replace-with-a-strong-password@127.0.0.1:5433/app_db
MFA_ENCRYPTION_KEY=replace-with-a-different-long-random-value

# Latest printer/agent updates older than this are displayed as stale.
MONITORING_STALE_SECONDS=180

# Nightly monitoring retention (defaults run at 02:30 Asia/Manila).
MONITORING_RETENTION_ENABLED=true
MONITORING_RAW_RETENTION_DAYS=30
MONITORING_SUMMARY_RETENTION_DAYS=730
RESOLVED_ALERT_RETENTION_DAYS=365
RETENTION_DELETE_BATCH_SIZE=10000
MONITORING_RETENTION_HOUR=2
MONITORING_RETENTION_MINUTE=30
MONITORING_RETENTION_TIMEZONE=Asia/Manila
SEED_SUPER_ADMIN_PASSWORD=replace-with-a-secure-super-admin-password
