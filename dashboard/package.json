{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "postinstall": "node scripts/patch-feral-blob.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:docker:up": "docker compose --env-file .env.docker up -d --wait db",
    "db:docker:down": "docker compose --env-file .env.docker down",
    "db:docker:logs": "docker compose --env-file .env.docker logs -f db",
    "db:push:docker": "drizzle-kit push --config=drizzle.docker.config.ts",
    "db:seed:docker": "node --env-file=.env.docker scripts/seed.mjs",
    "db:setup:docker": "npm run db:docker:up && npm run db:migrate:office-naming:docker && npm run db:push:docker && npm run db:seed:docker",
    "monitoring:agent": "node scripts/monitoring-agent-credentials.mjs",
    "monitoring:agent:create": "node scripts/monitoring-agent-credentials.mjs create",
    "monitoring:agent:rotate": "node scripts/monitoring-agent-credentials.mjs rotate",
    "monitoring:agent:revoke": "node scripts/monitoring-agent-credentials.mjs revoke",
    "monitoring:agent:migrate-global": "node scripts/monitoring-agent-credentials.mjs migrate-global",
    "monitoring:retention": "node --env-file-if-exists=.env.local scripts/prune-monitoring-history.mjs",
    "monitoring:retention:dry-run": "node --env-file-if-exists=.env.local scripts/prune-monitoring-history.mjs --dry-run",
    "monitoring:retention:worker": "node --env-file-if-exists=.env.local scripts/monitoring-retention-worker.mjs",
    "db:migrate:monitoring-retention": "node --env-file=.env.local scripts/migrate-monitoring-retention.mjs",
    "db:migrate:monitoring-retention:docker": "node --env-file=.env.docker scripts/migrate-monitoring-retention.mjs",
    "monitoring:assignments:migrate": "node scripts/migrate-monitoring-assignments.mjs",
    "db:migrate:agent-locations": "node --env-file=.env.local scripts/migrate-monitoring-agent-locations.mjs",
    "uploads:migrate:private": "node scripts/migrate-private-uploads.mjs",
    "db:migrate:auth-security": "node scripts/migrate-auth-security.mjs",
    "db:migrate:mfa": "node --env-file=.env.local scripts/migrate-mfa.mjs",
    "db:migrate:mfa:docker": "node --env-file=.env.docker scripts/migrate-mfa.mjs",
    "db:migrate:temporary-password": "node --env-file=.env.local scripts/migrate-temporary-password.mjs",
    "db:migrate:temporary-password:docker": "node --env-file=.env.docker scripts/migrate-temporary-password.mjs",
    "db:migrate:repair-sequence": "node scripts/migrate-repair-ticket-sequence.mjs",
    "db:migrate:agent-locations:docker": "node --env-file=.env.docker scripts/migrate-monitoring-agent-locations.mjs",
    "db:migrate:features": "node scripts/migrate-notifications-registration-smtp.mjs",
    "db:migrate:features:docker": "node --env-file=.env.docker scripts/migrate-notifications-registration-smtp.mjs",
    "db:migrate:remove-brand": "node --env-file=.env.local scripts/remove-printer-brand.mjs",
    "db:migrate:remove-brand:docker": "node --env-file=.env.docker scripts/remove-printer-brand.mjs",
    "db:migrate:mac": "node --env-file=.env.local scripts/add-printer-mac-address.mjs",
    "db:migrate:mac:docker": "node --env-file=.env.docker scripts/add-printer-mac-address.mjs",
    "db:migrate:printer-floor": "node --env-file=.env.local scripts/add-printer-floor.mjs",
    "db:migrate:printer-floor:docker": "node --env-file=.env.docker scripts/add-printer-floor.mjs",
    "db:migrate:printer-permissions": "node --env-file=.env.local scripts/add-user-printer-permissions.mjs",
    "db:migrate:printer-permissions:docker": "node --env-file=.env.docker scripts/add-user-printer-permissions.mjs",
    "db:migrate:printer-access-requests": "node --env-file=.env.local scripts/add-printer-access-requests.mjs",
    "db:migrate:printer-access-requests:docker": "node --env-file=.env.docker scripts/add-printer-access-requests.mjs",
    "db:migrate:agent-management": "node --env-file=.env.local scripts/migrate-agent-management.mjs",
    "db:migrate:agent-management:docker": "node --env-file=.env.docker scripts/migrate-agent-management.mjs",
    "db:migrate:toner-unit-cost": "node --env-file=.env.local scripts/add-toner-unit-cost.mjs",
    "db:migrate:toner-unit-cost:docker": "node --env-file=.env.docker scripts/add-toner-unit-cost.mjs",
    "db:migrate:organization": "node --env-file=.env.local scripts/migrate-organization-data.mjs",
    "db:migrate:organization:docker": "node --env-file=.env.docker scripts/migrate-organization-data.mjs",
    "db:migrate:office-naming": "node --env-file=.env.local scripts/migrate-office-naming.mjs",
    "db:migrate:office-naming:docker": "node --env-file=.env.docker scripts/migrate-office-naming.mjs"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "feral-blob": "0.1.0",
    "goey-toast": "^0.5.0",
    "jsonwebtoken": "^9.0.3",
    "lucide": "^1.33.0",
    "morphicons": "^1.7.0",
    "motion": "^13.1.1",
    "next": "^16.3.5",
    "nodemailer": "^9.1.1",
    "pg": "8.20.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-grid-layout": "^2.2.4",
    "zod": "^4.4.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.5",
    "postcss": "^8.5.28",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
