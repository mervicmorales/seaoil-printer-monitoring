cat > .gitignore <<'EOF'
# Dependencies
node_modules/
**/node_modules/

# Environment files / secrets
.env
.env.local
.env.development
.env.production
.env.test
.env.docker
.env.*.local

# Keep environment templates
!.env.example
!.env.*.example

# Next.js
.next/
out/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# macOS
.DS_Store
**/.DS_Store

# IDE
.vscode/
.idea/

# Testing / coverage
coverage/

# Temporary files
*.tmp
*.temp
EOF
# TypeScript build cache
*.tsbuildinfo

# Runtime/user uploaded files
dashboard/public/uploads/
dashboard/storage/uploads/
