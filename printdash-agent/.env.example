# Central SEAOIL monitoring API. Use HTTPS for remote-office deployments.
SEAOIL_API_URL=https://monitoring.example.com/api/monitoring/ingest

# Optional. By default this is derived from SEAOIL_API_URL by replacing
# /ingest with /config.
SEAOIL_CONFIG_URL=https://monitoring.example.com/api/monitoring/config

# Required unique secret generated by the central agent credential command.
# This placeholder is not a working token. Never commit the real value.
SEAOIL_AGENT_TOKEN=replace-with-a-long-random-token

# Required stable, non-secret identity. Keep this unchanged for this office.
SEAOIL_AGENT_KEY=head-office-agent
SEAOIL_AGENT_NAME=Head Office Agent

# Optional non-secret release/build label displayed in Agent Management.
SEAOIL_AGENT_BUILD_ID=

# Optional human-readable office/location metadata.
SEAOIL_AGENT_LOCATION=Head Office

# Valid range: 30-3600 seconds. Invalid values fall back to 60.
POLL_INTERVAL_SECONDS=60

# How often central printer assignments are refreshed (valid: 30-3600).
SEAOIL_CONFIG_REFRESH_SECONDS=60

# Persisted last-known-good central assignment cache (contains no credentials).
SEAOIL_CONFIG_CACHE_FILE=./seaoil-config-cache.json

# Kept only on the remote agent; never returned to or uploaded by the API.
SEAOIL_SNMP_COMMUNITY=replace-with-office-snmp-community

# PrintDash dashboard and local runtime paths.
PORT=3003
# Docker Compose publishes the container on localhost by default.
PRINTDASH_BIND_ADDRESS=127.0.0.1
PRINTDASH_PORT=3003
# Direct npm starts keep the historical all-interface listener. The WinSW
# template overrides this with 127.0.0.1.
PRINTDASH_LISTEN_ADDRESS=0.0.0.0
# Windows service deployments set this outside this file to the protected
# C:\ProgramData\SEAOIL\PrinterAgent\config\agent.env path.
# SEAOIL_ENV_FILE=
USERS_FILE=./users.json
DATA_FILE=./printers.json
SETTINGS_FILE=./settings.json
SCAN_DIR=/opt/scans
UPLOAD_DIR=/tmp/printdash-uploads

# Required only when USERS_FILE does not exist on a production/service start.
# Use unique values of at least 12 characters; never commit the real values.
PRINTDASH_ADMIN_PASSWORD=replace-with-a-secure-admin-password
PRINTDASH_USER_PASSWORD=replace-with-a-secure-user-password
